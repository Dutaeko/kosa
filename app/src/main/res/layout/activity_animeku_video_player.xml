<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:focusable="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:keepScreenOn="true"
        app:show_buffering="never"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/player_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <View
        android:id="@+id/player_center_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_center_scrim" />

    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/player_overlay_top"
        android:gravity="top|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/player_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/player_round_button"
            android:contentDescription="Kembali"
            android:padding="9dp"
            android:src="@drawable/ic_player_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Anime"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/player_chip"
                    android:text="HD"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/player_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/player_chip"
                    android:text="1.00x"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/player_previous"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/player_round_button"
            android:contentDescription="Episode sebelumnya"
            android:padding="13dp"
            android:src="@drawable/ic_player_previous" />

        <ImageButton
            android:id="@+id/player_rewind"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/player_round_button"
            android:contentDescription="Mundur 10 detik"
            android:padding="13dp"
            android:src="@drawable/ic_player_rewind" />

        <ImageButton
            android:id="@+id/player_play_pause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/player_play_button"
            android:contentDescription="Play pause"
            android:padding="19dp"
            android:src="@drawable/ic_player_play" />

        <ImageButton
            android:id="@+id/player_forward"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/player_round_button"
            android:contentDescription="Maju 10 detik"
            android:padding="13dp"
            android:src="@drawable/ic_player_forward" />

        <ImageButton
            android:id="@+id/player_next"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/player_round_button"
            android:contentDescription="Episode berikutnya"
            android:padding="13dp"
            android:src="@drawable/ic_player_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_gravity="bottom"
        android:background="@drawable/player_overlay_bottom"
        android:gravity="bottom|center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <SeekBar
            android:id="@+id/player_seek"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/player_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/player_seek_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:text="/"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/player_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/player_lock"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/player_round_button"
        android:contentDescription="Kunci layar"
        android:padding="11dp"
        android:src="@drawable/ic_player_lock" />

    <TextView
        android:id="@+id/player_locked_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_locked_hint"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="Player terkunci"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
